<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FloralOrder" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/pink_dark</item>
        <item name="colorPrimaryDark">@color/header_start</item>
        <item name="colorAccent">@color/green_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:statusBarColor">@color/header_start</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="alertDialogTheme">@style/Theme.FloralOrder.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.FloralOrder.Dialog</item>
    </style>

    <!-- Frosted-glass dialogs -->
    <style name="Theme.FloralOrder.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/pink_dark</item>
        <item name="colorAccent">@color/pink_dark</item>
        <item name="android:windowBackground">@drawable/dialog_glass_bg</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FloralOrder.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.FloralOrder.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.FloralOrder.DialogButton</item>
    </style>

    <style name="Widget.FloralOrder.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pink_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
